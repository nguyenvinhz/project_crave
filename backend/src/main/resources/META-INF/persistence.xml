<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">
    <persistence-unit name="QuanLyDatDoAnPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.crave.entity.Customer</class>
        <class>com.crave.entity.Staff</class>
        <class>com.crave.entity.Category</class>
        <class>com.crave.entity.Food</class>
        <class>com.crave.entity.FoodOption</class>
        <class>com.crave.entity.ShippingAddress</class>
        <class>com.crave.entity.Promotion</class>
        <class>com.crave.entity.Cart</class>
        <class>com.crave.entity.CartItem</class>
        <class>com.crave.entity.FoodOrder</class>
        <class>com.crave.entity.OrderItem</class>
        <class>com.crave.entity.OrderStatusHistory</class>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="hibernate.connection.provider_class" value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider"/>
            <property name="hibernate.hikari.jdbcUrl" value="jdbc:mysql://localhost:3306/QuanLyDatDoAn?useUnicode=true&amp;characterEncoding=UTF-8&amp;serverTimezone=Asia/Ho_Chi_Minh"/>
            <property name="hibernate.hikari.username" value="root"/>
            <property name="hibernate.hikari.password" value=""/>
            <property name="hibernate.hikari.maximumPoolSize" value="10"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="none"/>
            <property name="hibernate.show_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>

